<idea-plugin>
    <extensions defaultExtensionNs="org.komlir.intelliJ-MLIR-plugin">
        <languageServerCMakeSupport implementation="org.komlir.intellijmlirplugin.lsp.cmake.MLIRCMakeLanguageServerSupport"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">

        <runLineMarkerContributor
                language="MLIR"
                implementationClass="org.komlir.intellijmlirplugin.MLIRRunLineMarkerContributor" />

        <stepsBeforeRunProvider implementation="org.komlir.intellijmlirplugin.run_configuration.MLIRBuildBeforeRunTaskProvider"/>

        <configurationType
                implementation="org.komlir.intellijmlirplugin.run_configuration.MLIRRunConfigurationType"/>

        <runConfigurationProducer
                implementation="org.komlir.intellijmlirplugin.run_configuration.MLIRRunConfigurationProducer"/>


    </extensions>
</idea-plugin>
